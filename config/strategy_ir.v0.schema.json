{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantpilot.local/schema/strategy_ir.v0.schema.json",
  "title": "QuantPilot Strategy IR v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ir_version",
    "metadata",
    "signals",
    "logic",
    "risk_rules",
    "data_requirements",
    "execution"
  ],
  "properties": {
    "ir_version": {
      "type": "string",
      "const": "strategy_ir/v0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_id", "name", "summary", "source"],
      "properties": {
        "strategy_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_type", "paper_title"],
          "properties": {
            "source_type": {
              "type": "string",
              "enum": ["manual_paper_analysis", "llm_paper_analysis", "human_authored", "imported"]
            },
            "paper_title": { "type": "string", "minLength": 1 },
            "paper_reference": { "type": ["string", "null"] }
          }
        },
        "authors": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal_id", "name", "indicator"],
        "properties": {
          "signal_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "indicator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "inputs"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["ma_cross", "rsi", "macd", "momentum", "spread", "z_score", "custom", "quote_observe", "atr", "bollinger_bands", "obv", "cmf", "adx", "stochastic", "cci", "parabolic_sar", "keltner_channel", "donchian_channel"]
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "params": {
                "type": "object",
                "default": {},
                "additionalProperties": true
              }
            }
          },
          "transforms": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      }
    },
    "logic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_rules", "position_sizing"],
      "properties": {
        "entry_rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/logicRule" }
        },
        "exit_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/logicRule" },
          "default": []
        },
        "position_sizing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "value", "unit"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["fixed_ratio", "volatility_target", "equal_weight", "risk_parity", "custom"]
            },
            "value": { "$ref": "#/$defs/knownOrUnknownNumber" },
            "unit": {
              "type": "string",
              "enum": ["portfolio_ratio", "leverage", "quantity", "notional"]
            }
          }
        },
        "rebalance_rule": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["frequency"],
          "properties": {
            "frequency": { "$ref": "#/$defs/knownOrUnknownString" },
            "condition": { "type": ["string", "null"] }
          }
        }
      }
    },
    "risk_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_position_ratio", "stop_loss_ratio"],
      "properties": {
        "max_position_ratio": { "$ref": "#/$defs/knownOrUnknownNumber" },
        "stop_loss_ratio": { "$ref": "#/$defs/knownOrUnknownNumber" },
        "take_profit_ratio": { "$ref": "#/$defs/knownOrUnknownNumberOrNull" },
        "max_drawdown_ratio": { "$ref": "#/$defs/knownOrUnknownNumberOrNull" },
        "max_trades_per_day": { "$ref": "#/$defs/knownOrUnknownIntegerOrNull" },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data_id",
          "venue",
          "symbol",
          "data_type",
          "granularity",
          "lookback",
          "fields"
        ],
        "properties": {
          "data_id": { "type": "string", "minLength": 1 },
          "venue": { "$ref": "#/$defs/knownOrUnknownString" },
          "symbol": { "$ref": "#/$defs/knownOrUnknownString" },
          "data_type": {
            "type": "string",
            "enum": ["kline", "quote", "tick", "order_book", "fundamental", "event"]
          },
          "granularity": { "$ref": "#/$defs/knownOrUnknownString" },
          "lookback": { "$ref": "#/$defs/knownOrUnknownInteger" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["venue_type", "order_type", "slippage_model"],
      "properties": {
        "venue_type": { "$ref": "#/$defs/knownOrUnknownString" },
        "order_type": { "$ref": "#/$defs/knownOrUnknownString" },
        "time_in_force": { "$ref": "#/$defs/knownOrUnknownStringOrNull" },
        "slippage_model": { "$ref": "#/$defs/knownOrUnknownString" },
        "latency_assumption_ms": { "$ref": "#/$defs/knownOrUnknownIntegerOrNull" },
        "capital_base": { "$ref": "#/$defs/knownOrUnknownNumberOrNull" }
      }
    },
    "gap_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_type", "summary", "severity", "blocking"],
        "properties": {
          "gap_type": {
            "type": "string",
            "enum": ["expression", "data", "execution", "risk", "other"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "blocking": { "type": "boolean" }
        }
      },
      "default": []
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      },
      "default": []
    }
  },
  "$defs": {
    "logicRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "condition", "action"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "action": {
          "type": "string",
          "enum": ["open_long", "close_long", "open_short", "close_short", "rebalance", "hold"]
        }
      }
    },
    "knownOrUnknownString": {
      "oneOf": [
        { "type": "string", "const": "unknown" },
        { "type": "string", "minLength": 1, "not": { "const": "unknown" } }
      ]
    },
    "knownOrUnknownStringOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/knownOrUnknownString" }
      ]
    },
    "knownOrUnknownNumber": {
      "oneOf": [
        { "type": "string", "const": "unknown" },
        { "type": "number" }
      ]
    },
    "knownOrUnknownNumberOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/knownOrUnknownNumber" }
      ]
    },
    "knownOrUnknownInteger": {
      "oneOf": [
        { "type": "string", "const": "unknown" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "knownOrUnknownIntegerOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/knownOrUnknownInteger" }
      ]
    }
  }
}
