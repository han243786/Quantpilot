{
  "name": "quantpilot-frontend",
  "private": true,
  "version": "3.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:e2e": "playwright test",
    "test:perf:first-screen": "vite build && set PERF_REVIEW=1 && playwright test -c playwright.perf.config.js tests/e2e/perf-first-screen-review.spec.js",
    "test:perf:react-flow": "vite build && set PERF_REVIEW=1 && playwright test -c playwright.perf.config.js tests/e2e/perf-react-flow-mount-review.spec.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:csp": "vite build --mode development",
    "build:csp:watch": "vite build --watch --mode development",
    "preview:csp": "vite preview --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@xyflow/react": "^12.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^2.2.7",
    "recharts": "^3.8.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^26.1.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
