# Rust build output
/target/
/target-test-*/

# Local document extraction scratch
/quantscript/_docx_extract/

# Codex local state
/.codex/

# Frontend dependencies and build output
/frontend/node_modules/
/frontend/dist/
/frontend/test-results/
/frontend/playwright-report/
/frontend/.playwright-browsers/
/frontend/.vite/

# Local environment overrides
/.env
/.env.local
/frontend/.env
/frontend/.env.local

# Plugin user data (installed/cache/disabled are user-managed)
/plugins/installed/*
/plugins/cache/*
/plugins/disabled/*
!/plugins/installed/.gitkeep
!/plugins/cache/.gitkeep
!/plugins/disabled/.gitkeep

# Runtime artifacts and local graph snapshots
/storage/
/storage/.credentials
/storage/.machine_key
/.quantpilot-tmp/

# Local helper files
/backend_pid.txt
/codex-vite-dev.log
/tmp_runtime_request.json
/tmp_test.txt

# Test artifacts (screenshots and reports)
markdown/测试/screenshots/
markdown/测试/test-reports/
markdown/测试/测试报告-*.md
/tmp/

# OS files
Thumbs.db
Desktop.ini
