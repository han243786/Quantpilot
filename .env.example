# QuantPilot release example environment
#
# The frontend Vite app lives in ./frontend.
# For local development, copy the relevant values into frontend/.env.local.

# Vite dev proxy target. Used by frontend/vite.config.js.
VITE_BACKEND_ORIGIN=http://127.0.0.1:3000

# Optional direct browser API base. Leave empty to use same-origin /api.
# VITE_API_BASE_URL=http://127.0.0.1:3000/api

