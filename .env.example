# QuantPilot v2.1.3 环境变量模板
#
# 复制此文件为 .env 并根据环境修改

# ── 服务器配置 ──

# 监听端口 (默认 3000)
QUANTPILOT_PORT=3000

# 绑定地址 (默认 127.0.0.1, 容器部署设为 0.0.0.0) — v2.0.1
QUANTPILOT_BIND_ADDR=127.0.0.1

# CORS 允许来源 (逗号分隔, 默认 localhost:5173)
QUANTPILOT_CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# ── 安全配置 ──

# API Key 认证 (留空则跳过认证并打印警告)
QUANTPILOT_API_KEY=

# JWT 密钥 (v2.0.0 多用户认证, 留空则使用 API Key 派生或随机生成)
# 生产环境必须设置: openssl rand -hex 32
QUANTPILOT_JWT_SECRET=

# 插件市场公钥 (v2.0.0 Ed25519 base64, 生产环境必须替换)
# 生成: ed25519-dalek 生成密钥对后 base64 编码
QUANTPILOT_MARKET_PUBLIC_KEY=

# 日志级别 (error|warn|info|debug, 默认 info) — v2.1.0
QUANTPILOT_LOG_LEVEL=info

# 开发模式 (true=跳过认证, false=启用认证)
# 生产环境必须设为 false
QUANTPILOT_DEV=false

# 速率限制 (每秒每IP最大请求数, 默认100)
QUANTPILOT_RATE_LIMIT_RPS=100

# 沙箱回放窗口 (天数, 默认30)
# QUANTPILOT_SANDBOX_REPLAY_WINDOW_DAYS=30

# 沙箱验证超时 (秒, 默认300)
# QUANTPILOT_SANDBOX_TIMEOUT_SECS=300

# 存储总配额 (MB, 默认500)
# QUANTPILOT_STORAGE_MAX_MB=500

# 磁盘水位告警阈值 (MB, 默认400 = 80% of 500MB)
# QUANTPILOT_STORAGE_WATERMARK_MB=400

# HTTP 代理 (用于 OKX 测试网流量路由)
# QUANTPILOT_PROXY=http://127.0.0.1:7890

# 混沌实验最大扰动时长 (毫秒, 默认10000)
# QUANTPILOT_CHAOS_MAX_DURATION_MS=10000

# ── 前端配置 ──

# Vite dev proxy 目标
VITE_BACKEND_ORIGIN=http://127.0.0.1:3000

# 可选: 浏览器直接 API base URL
# VITE_API_BASE_URL=http://127.0.0.1:3000/api

# ── 交易所模拟盘配置 ──

# Binance Testnet API Key (模拟盘, flag=0)
# 仅在 @run { mode: "testnet" } 时需要
# 密钥不入库、不入日志、不入 API 响应
QUANTPILOT_EXCHANGE_KEY=

# Binance Testnet API Secret
QUANTPILOT_EXCHANGE_SECRET=

# Binance Testnet API Passphrase (required for OKX)
QUANTPILOT_EXCHANGE_PASSPHRASE=
