# QuantPilot 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# ── 运行模式 ──
# DEV模式: 跳过认证 + 缩短TTL + 跳过速率限制 (仅开发环境)
QUANTPILOT_DEV=true

# ── 日志 ──
# 日志格式: compact (默认) | json (生产)
QUANTPILOT_LOG_FORMAT=compact

# ── 安全 ──
# JWT 密钥 (留空自动生成并持久化到 storage/.jwt_secret)
# QUANTPILOT_JWT_SECRET=your-secret-here

# API 密钥 (用于执行端 API 守卫 HMAC 验证)
# QUANTPILOT_API_KEY=your-api-key-here

# 插件市场公钥 (Ed25519, 生产环境必须设置)
# QUANTPILOT_MARKET_PUBLIC_KEY=your-ed25519-public-key-hex

# ── 速率限制 ──
# 全局限速 (请求/秒, 默认100)
# QUANTPILOT_RATE_LIMIT_RPS=100

# ── 存储 ──
# 存储根目录 (默认 ./storage)
# QUANTPILOT_STORAGE_ROOT=storage

# ── 执行端 ──
# 执行端地址 (测试端部署策略时使用)
# QUANTPILOT_EXECUTOR_URL=http://127.0.0.1:3001

# 执行端不安全模式: 跳过 API 守卫 HMAC 验证 (仅开发环境)
# QUANTPILOT_EXECUTOR_INSECURE=true

# ── 代理 ──
# 可信代理模式 (在反向代理后运行时启用, 使用 X-Forwarded-For 作为客户端IP)
# QUANTPILOT_TRUSTED_PROXY=true
